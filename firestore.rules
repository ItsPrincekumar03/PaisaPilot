rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isActiveUser(userId) {
      return isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && 'accountStatus' in get(/databases/$(database)/documents/users/$(userId)).data
        && get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == 'active';
    }

    function isIsoDate(value) {
      return value is string
        && value.matches(
          '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'
        )
        && (
          value.matches(
            '^[0-9]{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])$'
          )
          || value.matches(
            '^[0-9]{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)$'
          )
          || value.matches(
            '^[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])$'
          )
          || (
            value.matches('^[0-9]{4}-02-29$')
            && (
              int(value.split('-')[0]) % 400 == 0
              || (
                int(value.split('-')[0]) % 4 == 0
                && int(value.split('-')[0]) % 100 != 0
              )
            )
          )
        );
    }

    function isMonthKey(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function isPositiveInt(value) {
      return value is int && value > 0;
    }

    function isNonEmptyText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isHexColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function requiredProfileFields() {
      return ['displayName', 'email', 'currency', 'theme', 'accountStatus', 'createdAt', 'updatedAt'];
    }

    // "language" is optional so profiles created before Module 4 remain valid.
    function profileFields() {
      return ['displayName', 'email', 'currency', 'theme', 'language', 'accountStatus', 'createdAt', 'updatedAt'];
    }

    function transactionFields() {
      return ['type', 'amountPaise', 'categoryId', 'date', 'description', 'createdAt', 'updatedAt'];
    }

    function budgetFields() {
      return ['monthKey', 'limitPaise', 'createdAt', 'updatedAt'];
    }

    function categoryFields() {
      return ['name', 'type', 'color', 'icon', 'active', 'createdAt', 'updatedAt'];
    }

    function isValidProfileContent(data) {
      return data.keys().hasOnly(profileFields())
        && data.keys().hasAll(requiredProfileFields())
        && isNonEmptyText(data.displayName, 80)
        && data.email == resource.data.email
        && data.currency in ['INR', 'USD', 'EUR', 'GBP']
        && data.theme in ['light', 'dark', 'system']
        && (!('language' in data) || data.language in ['en']);
    }

    function isValidNewProfileContent(data) {
      return data.keys().hasOnly(profileFields())
        && data.keys().hasAll(requiredProfileFields())
        && isNonEmptyText(data.displayName, 80)
        && data.email == request.auth.token.email
        && data.currency in ['INR', 'USD', 'EUR', 'GBP']
        && data.theme in ['light', 'dark', 'system']
        && (!('language' in data) || data.language in ['en']);
    }

    function isValidTransaction(data) {
      return data.keys().hasOnly(transactionFields())
        && data.keys().hasAll(transactionFields())
        && data.type in ['income', 'expense']
        && isPositiveInt(data.amountPaise)
        && data.amountPaise <= 1000000000
        && isNonEmptyText(data.categoryId, 64)
        && isIsoDate(data.date)
        && isNonEmptyText(data.description, 200);
    }

    function recurringFields() {
      return ['type', 'amountPaise', 'categoryId', 'description', 'frequency', 'startDate', 'endDate', 'status', 'nextIndex', 'nextDate', 'createdAt', 'updatedAt'];
    }

    function isValidRecurringSchedule(data) {
      return data.keys().hasOnly(recurringFields())
        && data.keys().hasAll(['type', 'amountPaise', 'categoryId', 'description', 'frequency', 'startDate', 'status', 'nextIndex', 'createdAt', 'updatedAt'])
        && data.type in ['income', 'expense']
        && isPositiveInt(data.amountPaise)
        && data.amountPaise <= 1000000000
        && isNonEmptyText(data.categoryId, 64)
        && isIsoDate(data.startDate)
        && (data.endDate == null || isIsoDate(data.endDate))
        && (data.endDate == null || data.endDate >= data.startDate)
        && isNonEmptyText(data.description, 200)
        && data.frequency in ['daily', 'weekly', 'monthly', 'yearly']
        && data.status in ['active', 'paused', 'cancelled']
        && data.nextIndex is int && data.nextIndex >= 0
        && (data.nextDate == null || isIsoDate(data.nextDate));
    }

    function categoryBudgetFields() {
      return ['monthKey', 'categoryId', 'limitPaise', 'createdAt', 'updatedAt'];
    }

    function isValidCategoryBudget(data, budgetId) {
      return data.keys().hasOnly(categoryBudgetFields())
        && data.keys().hasAll(categoryBudgetFields())
        && isMonthKey(data.monthKey)
        && isNonEmptyText(data.categoryId, 64)
        && budgetId == data.monthKey + '_' + data.categoryId
        && isPositiveInt(data.limitPaise)
        && data.limitPaise <= 1000000000;
    }

    function isValidBudget(data, monthId) {
      return (
        isMonthKey(monthId)
        && data.keys().hasOnly(budgetFields())
        && data.keys().hasAll(budgetFields())
        && data.monthKey == monthId
        && isPositiveInt(data.limitPaise)
      ) || isValidCategoryBudget(data, monthId);
    }

    function isValidCategory(data) {
      return data.keys().hasOnly(categoryFields())
        && data.keys().hasAll(categoryFields())
        && isNonEmptyText(data.name, 60)
        && data.type in ['income', 'expense']
        && isHexColor(data.color)
        && isNonEmptyText(data.icon, 40)
        && data.active is bool;
    }

    // ---------- User profile ----------

    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      // Clients may create only an active INR profile whose email matches their sign-in.
      // They cannot set role, admin, or suspension fields.
      allow create: if isOwner(userId)
        && isValidNewProfileContent(request.resource.data)
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Clients may change only safe preferences. accountStatus and createdAt are locked.
      // Authorized administrators may update accountStatus (active/suspended) on other users without self-lockout.
      allow update: if (isOwner(userId)
        && isValidProfileContent(request.resource.data)
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time)
        || (isAdmin()
        && request.auth.uid != userId
        && request.resource.data.accountStatus in ['active', 'suspended']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus', 'updatedAt'])
        && request.resource.data.updatedAt == request.time);

      // Account deletion must go through a trusted backend that removes subcollections.
      allow delete: if false;

      // ---------- Transactions ----------

      match /transactions/{transactionId} {

        allow read: if isOwner(userId);

        allow create: if isActiveUser(userId)
          && isValidTransaction(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isActiveUser(userId)
          && isValidTransaction(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isActiveUser(userId);
      }

      // ---------- Budgets ----------

      match /budgets/{budgetId} {

        allow read: if isOwner(userId);

        allow create: if isActiveUser(userId)
          && isValidBudget(request.resource.data, budgetId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isActiveUser(userId)
          && isValidBudget(request.resource.data, budgetId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isActiveUser(userId);
      }
      // ---------- Recurring Schedules ----------

      match /recurring/{scheduleId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidRecurringSchedule(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(userId)
          && isValidRecurringSchedule(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(userId);
      }

      // ---------- Personal categories (reserved for future use) ----------

      match /categories/{categoryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidCategory(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(userId)
          && isValidCategory(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(userId);
      }
    }

    // ---------- Global categories ----------

    match /categories/{categoryId} {

      allow read: if isSignedIn();

      allow create, update, delete: if false;
    }

    // ---------- Explicitly deny collections not intended for client access ----------

    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
