# Firebase WEB app configuration.
# These values are public client-side settings, not secrets and not admin credentials.
# Security comes from Firestore Security Rules, not from hiding these values.
#
# To use: copy this file to .env.local and fill in the values from
# Firebase Console > Project settings > Your apps > Web app config.
# Never put Firebase Admin SDK keys or service-account JSON in any VITE_ variable.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to true ONLY when the Firebase emulators are running locally.
VITE_FIREBASE_USE_EMULATOR=false